{
  "name": "ladder-ide",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n web,server -c cyan,magenta \"npm run dev -w @ladder/web\" \"npm run dev -w @ladder/server\"",
    "dev:web": "npm run dev -w @ladder/web",
    "build": "npm run build -w @ladder/web",
    "start": "npm run start -w @ladder/server",
    "test": "vitest run",
    "typecheck": "tsc -p packages/core && tsc -p apps/web && tsc -p apps/server && tsc -p apps/bridge",
    "e2e": "playwright test",
    "format": "prettier --write .",
    "db:up": "docker compose up -d db",
    "test:db": "TEST_DATABASE_URL=postgres://ladder:ladder@localhost:5432/ladder vitest run apps/server",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm test",
    "format:check": "prettier --check .",
    "bridge": "node apps/bridge/src/index.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24"
  }
}
