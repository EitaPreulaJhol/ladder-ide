# Copie para .env. Sem DATABASE_URL o servidor usa armazenamento em memória.
DATABASE_URL=postgres://ladder:ladder@localhost:5432/ladder
PORT=3000
# Atrás de um proxy reverso (nginx, Caddy...): IPs/CIDRs do proxy, separados por vírgula
# (aceita também 'loopback', 'linklocal', 'uniquelocal'). Só deles o X-Forwarded-For é aceito,
# para o rate limit e as denúncias verem o IP real do cliente.
TRUSTED_PROXIES=
# Legado: 1 confia no X-Forwarded-For de QUALQUER origem (inseguro se o servidor for acessível sem o proxy).
TRUST_PROXY=0
# Rotas /api/admin/* (denúncias, remover/restaurar links). Use 24+ caracteres aleatórios; vazio = desativadas.
ADMIN_TOKEN=
# Segredo para o hash anônimo de quem denuncia (sem ele, o agrupamento zera a cada reinício).
HASH_SALT=
# Limite total de armazenamento dos links compartilhados (MB) e denúncias para ocultar um link.
STORAGE_LIMIT_MB=512
REPORT_HIDE_THRESHOLD=3
# 1 = enviar Strict-Transport-Security (somente atrás de HTTPS).
HSTS=0
